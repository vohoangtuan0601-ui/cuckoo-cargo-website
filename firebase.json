{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.sample",
      "HEAD",
      "FETCH_HEAD",
      "COMMIT_EDITMSG",
      "index",
      "config",
      "description",
      "tnoElzh",
      "img_tags.txt",
      "*.js.map",
      "all_fixes.txt",
      "last_fix.txt",
      "fix_*.js",
      "restore_*.js",
      "google-apps-script.js",
      "*.bat",
      "*.ps1",
      "*.sh",
      "*.xlsx",
      "*.py",
      "pages/**",
      "mockup-ui.html",
      "test-form.html",
      "*.md"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/quote-system", "destination": "/quote-system/index.html" }
    ],
    "redirects": [
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/my-ve-viet.html", "destination": "/my-ve-viet", "type": 301 },
      { "source": "/gui-hang-my-ve-viet.html", "destination": "/my-ve-viet", "type": 301 },
      { "source": "/noi-dia-my.html", "destination": "/label-noi-dia-my", "type": 301 },
      { "source": "/label-noi-dia-my.html", "destination": "/label-noi-dia-my", "type": 301 },
      { "source": "/mua-ho.html", "destination": "/mua-ho-hang-my", "type": 301 },
      { "source": "/mua-ho-hang-my.html", "destination": "/mua-ho-hang-my", "type": 301 },
      { "source": "/san-pham.html", "destination": "/san-pham", "type": 301 },
      { "source": "/blog.html", "destination": "/blog", "type": 301 },
      { "source": "/tracking.html", "destination": "/tracking", "type": 301 },
      { "source": "/lien-he.html", "destination": "/lien-he", "type": 301 },
      { "source": "/dieu-khoan.html", "destination": "/dieu-khoan", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "X-XSS-Protection", "value": "1; mode=block" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://script.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://script.google.com https://firestore.googleapis.com; frame-ancestors 'none';" }
        ]
      },
      {
        "source": "assets/js/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "assets/css/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "quote-system/css/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "quote-system/js/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ]
  }
}
