{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.sample",
      "HEAD",
      "FETCH_HEAD",
      "COMMIT_EDITMSG",
      "index",
      "config",
      "description",
      "tnoElzh",
      "img_tags.txt",
      "*.js.map",
      "all_fixes.txt",
      "last_fix.txt",
      "fix_*.js",
      "restore_*.js",
      "google-apps-script.js",
      "*.bat",
      "*.ps1",
      "*.sh",
      "*.xlsx",
      "*.py",
      "pages/**",
      "mockup-ui.html",
      "test-form.html",
      "*.md"
    ],
    "rewrites": [
      { "source": "/quote-system", "destination": "/quote-system/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "assets/js/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "assets/css/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ]
  }
}
