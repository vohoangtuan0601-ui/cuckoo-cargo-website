{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.sample",
      "HEAD",
      "FETCH_HEAD",
      "COMMIT_EDITMSG",
      "index",
      "config",
      "description",
      "tnoElzh",
      "img_tags.txt",
      "*.js.map",
      "all_fixes.txt",
      "last_fix.txt",
      "fix_*.js",
      "restore_*.js",
      "google-apps-script.js",
      "*.bat",
      "*.ps1",
      "*.sh",
      "*.xlsx",
      "*.py",
      "pages/**",
      "mockup-ui.html",
      "test-form.html",
      "*.md"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/trang-chu", "destination": "/index.html" },
      { "source": "/quote-system", "destination": "/quote-system/index.html" }
    ],
    "redirects": [
      { "source": "/my-ve-viet", "destination": "/gui-hang-my-ve-viet", "type": 301 },
      { "source": "/noi-dia-my", "destination": "/label-noi-dia-my", "type": 301 },
      { "source": "/mua-ho", "destination": "/mua-ho-hang-my", "type": 301 },
      { "source": "/my-ve-viet.html", "destination": "/gui-hang-my-ve-viet", "type": 301 },
      { "source": "/noi-dia-my.html", "destination": "/label-noi-dia-my", "type": 301 },
      { "source": "/mua-ho.html", "destination": "/mua-ho-hang-my", "type": 301 },
      { "source": "/san-pham.html", "destination": "/san-pham", "type": 301 },
      { "source": "/lien-he.html", "destination": "/lien-he", "type": 301 },
      { "source": "/blog.html", "destination": "/blog", "type": 301 },
      { "source": "/tracking.html", "destination": "/tracking", "type": 301 },
      { "source": "/index.html", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
